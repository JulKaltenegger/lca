:B6 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#B7
:B7 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#C1
:C1 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#C2
:C2 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#C3
:C3 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#C4
:C4 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#D
:D rdf:type owl:Class ;
   rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#EP
:EP rdf:type owl:Class ;
    rdfs:subClassOf :EnvironmentalIndicator ;
    rdfs:comment "Eutrophication Potential (EP)" .


###  https://w3id.org/lca#EnvironmentalIndicator
:EnvironmentalIndicator rdf:type owl:Class ;
                        rdfs:comment "Describes environmental and economic indicators following ISO 11620" .


###  https://w3id.org/lca#FunctionalEquivalent
:FunctionalEquivalent rdf:type owl:Class ;
                      rdfs:comment "Description of the building with regard to its material and time-dependent properties" .


###  https://w3id.org/lca#GWP
:GWP rdf:type owl:Class ;
     rdfs:subClassOf :EnvironmentalIndicator ;
     rdfs:comment "Global Warming Potential (GWP)" .


###  https://w3id.org/lca#LifeCycleStage
:LifeCycleStage rdf:type owl:Class .


###  https://w3id.org/lca#Material
:Material rdf:type owl:Class .


###  https://w3id.org/lca#MaterialIn
:MaterialIn rdf:type owl:Class ;
            rdfs:subClassOf :ActivityType .


###  https://w3id.org/lca#MaterialLoss
:MaterialLoss rdf:type owl:Class ;
              rdfs:subClassOf :ActivityType .


###  https://w3id.org/lca#MaterialOut
:MaterialOut rdf:type owl:Class ;
             rdfs:subClassOf :ActivityType .


###  https://w3id.org/lca#ODP
:ODP rdf:type owl:Class ;
     rdfs:subClassOf :EnvironmentalIndicator ;
     rdfs:comment "Ozone Depletion Potential (ODP)" .


###  https://w3id.org/lca#PEGES
:PEGES rdf:type owl:Class ;
       rdfs:subClassOf :EnvironmentalIndicator ;
       rdfs:comment "Total primary energy demand (PEges)" .


###  https://w3id.org/lca#PENE
:PENE rdf:type owl:Class ;
      rdfs:subClassOf :EnvironmentalIndicator ;
      rdfs:comment "Non-renewable primary energy demand (PEne)" .


###  https://w3id.org/lca#POCP
:POCP rdf:type owl:Class ;
      rdfs:subClassOf :EnvironmentalIndicator ;
      rdfs:comment "Photochemical Ozone Creation Potential (POCP)" .


###  https://w3id.org/lca#Process
:Process rdf:type owl:Class ;
         rdfs:subClassOf :ActivityType .


###  https://w3id.org/lca#ReferenceStudyPeriod
:ReferenceStudyPeriod rdf:type owl:Class ;
                      rdfs:comment """50 years for office building;
100 years for residential building;""" .


###  https://w3id.org/lca#SystemBoundary
:SystemBoundary rdf:type owl:Class ;
                rdfs:comment "Entire buildings, without: -outdoor facilities -selected technical equipment" .


###  https://w3id.org/lca#TransportEoL
:TransportEoL rdf:type owl:Class ;
              rdfs:subClassOf :ActivityType .


###  https://w3id.org/lca#TransportToSite
:TransportToSite rdf:type owl:Class ;
                 rdfs:subClassOf :ActivityType .


###  https://w3id.org/lca#WF
:WF rdf:type owl:Class ;
    rdfs:subClassOf :EnvironmentalIndicator ;
    rdfs:comment "Water consumption (WF)" .


