@prefix : <https://w3id.org/lca#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/lca#> .

<https://w3id.org/lca#> rdf:type owl:Ontology ;
                         <http://purl.org/dc/terms/contributor> :Martin_Röck ;
                         <http://purl.org/dc/terms/creator> :Julia_Kaltenegger ;
                         <http://purl.org/dc/terms/description> "The Life Cycle Assessment ontology assignes Life Cycle Inventories to construction materials. The Life Cycle Inventory is discussed and outlines the required input and output for Life Cycle Assessment calculations. Calculation Base relies on DIN EN 15978." ;
                         <http://purl.org/dc/terms/title> "Life Cycle Assessment Ontology for building material performance" ;
                         owl:versionInfo 1.0 ;
                         :preferredNamespaceUri "https://w3id.org/lca#" ;
                         <https://w3id.org/lca#:preferredNamespacePrefix> "lca" .

