###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  https://w3id.org/lca#preferredNamespaceUri
:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  https://w3id.org/lca#:preferredNamespacePrefix
<https://w3id.org/lca#:preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/lca#hasActivityType
:hasActivityType rdf:type owl:ObjectProperty ;
                 rdfs:domain :Material ;
                 rdfs:range :MaterialIn ,
                            :MaterialLoss ,
                            :MaterialOut ,
                            :Process ,
                            :TransportEoL ,
                            :TransportToSite .


###  https://w3id.org/lca#hasEnvironmentalIndicator
:hasEnvironmentalIndicator rdf:type owl:ObjectProperty ;
                           rdfs:domain :Material ;
                           rdfs:range :ADPE ,
                                      :ADPF ,
                                      :AP ,
                                      :EP ,
                                      :GWP ,
                                      :ODP ,
                                      :PEGES ,
                                      :PENE ,
                                      :POCP ,
                                      :WF .


###  https://w3id.org/lca#hasLifeCycleStage
:hasLifeCycleStage rdf:type owl:ObjectProperty ;
                   rdfs:domain :Material ;
                   rdfs:range :A1 ,
                              :A2 ,
                              :A3 ,
                              :A4 ,
                              :A5 ,
                              :B1 ,
                              :B2 ,
                              :B3 ,
                              :B4 ,
                              :B5 ,
                              :B6 ,
                              :B7 ,
                              :C1 ,
                              :C2 ,
                              :C3 ,
                              :C4 ,
                              :D .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/lca#hasValue
:hasValue rdf:type owl:DatatypeProperty ;
          rdfs:domain :ADPE ,
                      :ADPF ,
                      :AP ,
                      :EP ,
                      :GWP ,
                      :ODP ,
                      :PEGES ,
                      :PENE ,
                      :POCP ,
                      :WF ;
          rdfs:range rdfs:Literal .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/lca#A1
:A1 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#A2
:A2 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#A3
:A3 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#A4
:A4 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#A5
:A5 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#ADPE
:ADPE rdf:type owl:Class ;
      rdfs:subClassOf :EnvironmentalIndicator ;
      rdfs:comment "Abiotic Depletion Potential for Elements (ADPE)" .


###  https://w3id.org/lca#ADPF
:ADPF rdf:type owl:Class ;
      rdfs:subClassOf :EnvironmentalIndicator ;
      rdfs:comment "Abiotic Depletion Potential of fossil Fuels (ADPF)" .


###  https://w3id.org/lca#AP
:AP rdf:type owl:Class ;
    rdfs:subClassOf :EnvironmentalIndicator ;
    rdfs:comment "Acidification Potential (AP)" .


###  https://w3id.org/lca#ActivityType
:ActivityType rdf:type owl:Class .


###  https://w3id.org/lca#Aim
:Aim rdf:type owl:Class ;
     rdfs:comment "Life-cycle oriented building planning" .


###  https://w3id.org/lca#B1
:B1 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#B2
:B2 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


###  https://w3id.org/lca#B3
:B3 rdf:type owl:Class ;
    rdfs:subClassOf :LifeCycleStage .


