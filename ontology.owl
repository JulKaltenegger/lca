    <owl:Ontology rdf:about="https://w3id.org/lca#">
        <terms:contributor rdf:resource="https://w3id.org/lca#Martin_Röck"/>
        <terms:creator rdf:resource="https://w3id.org/lca#Julia_Kaltenegger"/>
        <terms:description>The Life Cycle Assessment ontology assignes Life Cycle Inventories to construction materials. The Life Cycle Inventory is discussed and outlines the required input and output for Life Cycle Assessment calculations. Calculation Base relies on DIN EN 15978.</terms:description>
        <terms:title>Life Cycle Assessment Ontology for building material performance</terms:title>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</owl:versionInfo>
        <preferredNamespaceUri>https://w3id.org/lca#</preferredNamespaceUri>
        <lca:preferredNamespacePrefix>lca</lca:preferredNamespacePrefix>
    </owl:Ontology>
    


